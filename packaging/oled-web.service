[Unit]
Description=EasePi A2 OLED web configuration
Documentation=https://github.com/ifroncy01/easepi-oled-daemon
After=network-online.target oled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/oled/oled-web -bind 0.0.0.0 -port 8099
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
